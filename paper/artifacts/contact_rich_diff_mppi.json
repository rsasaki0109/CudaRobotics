{
  "schema_version": 1,
  "paper_id": "contact-rich-diff-mppi",
  "title": "Contact-Rich Diff-MPPI: Hybrid Sampling and Gradient Refinement for GPU Manipulation",
  "claims": [
    {
      "id": "fixed_seed_contact_signal",
      "statement": "At K=256 on four fixed seeds of box_align_contact_loss, Diff-MPPI-3 and SOPPI-fast each solve 4/4 runs while vanilla MPPI solves 0/4.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "box_pushing_fixed_seed"
      ],
      "limitations": [
        "This is a fixed-seed signal from one contact-loss scenario, not a broad statistical or paper-level superiority claim.",
        "SOPPI-fast includes one nominal gradient step and must not be described as pure SVGD."
      ]
    },
    {
      "id": "contact_suite_robustness",
      "statement": "The contact-rich advantage persists across multiple object shapes, friction/contact parameters, rollout budgets, and at least thirty independently generated seeds.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "contact_robustness_suite"
      ],
      "limitations": [
        "The 32,400-episode release matrix is GPU simulation evidence, not real-robot evidence.",
        "The advantage is not universal: the preregistered family contains 33 Holm-significant positive cells and 6 Holm-significant negative cells."
      ]
    },
    {
      "id": "matched_compute_contact",
      "statement": "Hybrid refinement improves contact-task success against sampling-only baselines under an exact matched wall-clock controller budget.",
      "submission_required": true,
      "status": "planned",
      "evidence": [
        "contact_matched_compute"
      ],
      "limitations": [
        "Current contact tables compare fixed K and report latency but do not enforce exact matched time."
      ]
    },
    {
      "id": "contact_model_fidelity",
      "statement": "The reported benefit survives a higher-fidelity contact simulator or real-robot manipulation evaluation with declared dynamics and sensing uncertainty.",
      "submission_required": true,
      "status": "planned",
      "evidence": [
        "contact_external_fidelity"
      ],
      "limitations": [
        "Current evidence uses the repository's lightweight box-pushing dynamics."
      ]
    },
    {
      "id": "hard_contact_transfer",
      "statement": "The contact-task comparison is repeated under a structurally different momentum-carrying hard-contact plant across friction and damping conditions.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "contact_robustness_suite"
      ],
      "limitations": [
        "This is sim-to-sim transfer and does not replace the MuJoCo external-fidelity or real-robot experiment."
      ]
    },
    {
      "id": "negative_result_detour",
      "statement": "On box_align_detour at K=256, the checked-in four-seed suite remains difficult: MPPI solves 0/4 and Diff-MPPI-3 solves only 1/4.",
      "submission_required": false,
      "status": "supported",
      "evidence": [
        "box_pushing_fixed_seed"
      ],
      "limitations": [
        "This negative result should remain visible and constrains any universal-success wording."
      ]
    }
  ],
