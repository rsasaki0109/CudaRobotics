{
  "schema_version": 1,
  "paper_id": "cudarobotics-systems",
  "title": "CudaNav: A Reproducible End-to-End GPU Autonomy Stack",
  "claims": [
    {
      "id": "reproducibility_contracts",
      "statement": "The repository provides distinct, machine-gated evidence contracts for closed-loop simulation, real-rosbag shadow replay, and physical multi-GPU reproduction.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "evidence_contract_sources"
      ],
      "limitations": [
        "This proves that the evidence contracts exist and are content-bound; it does not substitute for executing their release profiles."
      ]
    },
    {
      "id": "real_dataset_materialization",
      "statement": "A content-addressed public Istanbul localization bag is acquired, inspected, and converted into a bounded deterministic Path sidecar with portable validation evidence.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "istanbul_materialization_smoke"
      ],
      "limitations": [
        "This proves real-file acquisition and derived-Path materialization only; it is neither a GPU controller run nor closed-loop evidence.",
        "The 120-second localization smoke is distinct from the 56 GB raw mapping-kit release dataset."
      ]
    },
    {
      "id": "real_gpu_odometry",
      "statement": "The reusable GPU KISS-ICP core processes a content-addressed 300-frame real PointCloud2 sequence with 0.778 m ATE RMSE and 2.961 percent final drift on an NVIDIA GeForce GTX 1660 Ti.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "istanbul_kiss_icp_gpu_smoke",
        "istanbul_kiss_icp_gpu_report"
      ],
      "limitations": [
        "This is a 29.9-second smoke profile on one GPU model, not the 120-second release profile or a multi-GPU result.",
        "A declared one-second startup offset excludes a documented GNSS initialization discontinuity of roughly 1.9 m and 146 degrees.",
        "This proves real-sensor GPU odometry only; it is neither a GPU controller run nor closed-loop evidence."
      ]
    },
    {
      "id": "real_gpu_core_shadow",
      "statement": "A content-addressed 300-frame real PointCloud2 sequence passes through GPU KISS-ICP, rolling voxel mapping, GPU ESDF inflation, and CUDA MPPI in one native shadow run with a 9.999 ms mean frame time.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "istanbul_all_gpu_core_smoke",
        "istanbul_all_gpu_core_report"
      ],
      "limitations": [
        "This is a 29.9-second smoke profile on one GPU model, not the 120-second release profile or a multi-GPU result.",
        "Two of 31 MPPI evaluations reported all rollouts colliding; both were retained as bounded safety interventions with zero linear speed.",
        "The native process does not prove ROS 2 runtime, applied commands, vehicle response, or closed-loop autonomy."
      ]
    },
    {
      "id": "native_gpu_core_closed_loop",
      "statement": "The native all-GPU core completes 30 continuous alternating S-course traversals over 1059.4 simulated seconds and 352.75 m: GPU KISS-ICP state drives voxel mapping, ESDF, and CUDA MPPI commands with zero collisions, 0.0035 percent final odometry drift, and zero deadline misses.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "native_gpu_closed_loop_smoke",
        "native_gpu_closed_loop_report",
        "native_gpu_closed_loop_release",
        "native_gpu_closed_loop_release_report"
      ],
      "limitations": [
        "This is a continuous native simulation on one GPU model, not a ROS 2 runtime or multi-GPU result.",
        "The plant and LiDAR are synthetic; this does not upgrade the separate real-data shadow evidence into a real-world closed-loop claim."
      ]
    },
    {
      "id": "integrated_gpu_stack",
      "statement": "GPU KISS-ICP, rolling voxel mapping, exact typed ESDF, a Nav2 costmap bridge, and CUDA MPPI build and run as one ROS 2 Jazzy stack.",
      "submission_required": true,
      "status": "partial",
      "evidence": [
        "stack_source_contract",
        "ros_jazzy_ci"
      ],
      "limitations": [
        "Reusable CUDA sources and ROS integration are present, but a green ROS 2 Jazzy build and plugin-load run from the paper commit is still required."
      ]
    },
    {
      "id": "closed_loop_autonomy",
      "statement": "CudaNav completes the deterministic S-course for at least ten minutes with zero collisions, less than one percent odometry drift, and less than one percent controller deadline misses.",
      "submission_required": true,
      "status": "partial",
      "evidence": [
        "native_gpu_closed_loop_release",
        "closed_loop_release"
      ],
      "limitations": [
        "The native GPU core passes the 30-traversal and ten-minute numerical contract, but no release-profile ROS 2 GPU run with retained MCAP and video is currently attached."
      ]
    },
    {
      "id": "real_data_shadow",
      "statement": "The same CUDA controller stack meets its declared latency, rollout-validity, and clearance gates on a content-addressed public real rosbag.",
      "submission_required": true,
      "status": "partial",
      "evidence": [
        "istanbul_all_gpu_core_smoke",
        "real_rosbag_release"
      ],
      "limitations": [
        "Rosbag replay is shadow-controller evidence and is not a closed-loop success claim.",
        "The selected public PointCloud2 dataset now has a passing native all-GPU core smoke, but a ROS 2 release-profile replay and its runtime attestation remain pending."
      ]
    },
    {
      "id": "multi_gpu_reproduction",
      "statement": "The native 30-traversal closed-loop release reproduces from the same commit and source digest on at least two distinct physical GPU UUIDs and model names.",
      "submission_required": true,
      "status": "partial",
      "evidence": [
        "native_gpu_matrix_gtx1660ti_node",
        "native_gpu_matrix_gtx1660ti_report",
        "multi_gpu_release"
      ],
      "limitations": [
        "The NVIDIA GeForce GTX 1660 Ti node is complete and UUID-bound; a second distinct physical GPU model at the identical commit and source digest is still required."
      ]
    }
  ],
