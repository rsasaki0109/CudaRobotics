{
  "schema_version": 1,
  "paper_id": "cudarobotics-systems",
  "title": "CudaNav: A Reproducible End-to-End GPU Autonomy Stack",
  "claims": [
    {
      "id": "reproducibility_contracts",
      "statement": "The repository provides distinct, machine-gated evidence contracts for closed-loop simulation, real-rosbag shadow replay, and physical multi-GPU reproduction.",
      "submission_required": true,
      "status": "supported",
      "evidence": [
        "evidence_contract_sources"
      ],
      "limitations": [
        "This proves that the evidence contracts exist and are content-bound; it does not substitute for executing their release profiles."
      ]
    },
    {
      "id": "integrated_gpu_stack",
      "statement": "GPU KISS-ICP, rolling voxel mapping, exact typed ESDF, a Nav2 costmap bridge, and CUDA MPPI build and run as one ROS 2 Jazzy stack.",
      "submission_required": true,
      "status": "partial",
      "evidence": [
        "stack_source_contract",
        "ros_jazzy_ci"
      ],
      "limitations": [
        "Reusable CUDA sources and ROS integration are present, but a green ROS 2 Jazzy build and plugin-load run from the paper commit is still required."
      ]
    },
    {
      "id": "closed_loop_autonomy",
      "statement": "CudaNav completes the deterministic S-course for at least ten minutes with zero collisions, less than one percent odometry drift, and less than one percent controller deadline misses.",
      "submission_required": true,
      "status": "planned",
      "evidence": [
        "closed_loop_release"
      ],
      "limitations": [
        "No release-profile ROS 2 GPU run is currently attached."
      ]
    },
    {
      "id": "real_data_shadow",
      "statement": "The same CUDA controller stack meets its declared latency, rollout-validity, and clearance gates on a content-addressed public real rosbag.",
      "submission_required": true,
      "status": "planned",
      "evidence": [
        "real_rosbag_release"
      ],
      "limitations": [
        "Rosbag replay is shadow-controller evidence and is not a closed-loop success claim.",
        "The selected public PointCloud2 dataset has deterministic Path and PointCloud2-clearance contracts, but its release-profile GPU run remains pending."
      ]
    },
    {
      "id": "multi_gpu_reproduction",
      "statement": "The closed-loop smoke gate reproduces from the same commit and configuration on at least two distinct physical GPU models.",
      "submission_required": true,
      "status": "planned",
      "evidence": [
        "multi_gpu_release"
      ],
      "limitations": [
        "No two-model physical GPU matrix is currently attached."
      ]
    }
  ],
