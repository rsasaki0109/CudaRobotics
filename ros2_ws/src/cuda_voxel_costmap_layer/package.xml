<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cuda_voxel_costmap_layer</name>
  <version>1.0.0</version>
  <description>Nav2 costmap bridge for CudaNav rolling voxel occupancy</description>
  <maintainer email="rsasaki0109@users.noreply.github.com">CudaRobotics maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <costmap_2d plugin="${prefix}/cuda_voxel_costmap_plugin.xml"/>
  </export>
</package>
